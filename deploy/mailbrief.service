[Unit]
Description=MailBrief SaaS
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/mailbrief
EnvironmentFile=/opt/mailbrief/.env
ExecStart=/opt/mailbrief/.venv/bin/gunicorn app.main:app -k uvicorn.workers.UvicornWorker -b 127.0.0.1:8000 --workers 2 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
