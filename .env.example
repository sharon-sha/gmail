# App
APP_NAME=MailBrief
APP_URL=http://localhost:8000
SECRET_KEY=change-this-to-a-long-random-string
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
FREE_PLAN_MONTHLY_LIMIT=100

# PostgreSQL (accounts database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mailbrief
POSTGRES_USER=mailbrief
POSTGRES_PASSWORD=your_postgres_password
# Or use one URL instead:
# DATABASE_URL=postgresql+psycopg2://mailbrief:your_postgres_password@localhost:5432/mailbrief

# Groq (platform AI key)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Worker
POLL_INTERVAL_SECONDS=60

# Legacy CLI only (single-user python main.py)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=your_chat_id
