# Production example — copy to .env on your server

APP_NAME=MailBrief
APP_URL=https://yourdomain.com
SECRET_KEY=generate-a-long-random-string-at-least-32-chars
GMAIL_REDIRECT_URI=https://yourdomain.com/auth/gmail/callback
FREE_PLAN_MONTHLY_LIMIT=100

# PostgreSQL (use managed DB or docker-compose db service)
POSTGRES_PASSWORD=strong_database_password
DATABASE_URL=postgresql+psycopg2://mailbrief:strong_database_password@db:5432/mailbrief

# Platform AI key (you pay for all user summaries)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

POLL_INTERVAL_SECONDS=60
